{
  "name": "obsidian-cardsmith",
  "version": "0.1.0",
  "description": "Generate print-ready, double-sided card decks from your notes — board game components, RPG reference cards, or any deck you print.",
  "main": "main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manolitto/obsidian-cardsmith.git"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "cards",
    "card-deck",
    "board-games",
    "ttrpg",
    "print",
    "pdf"
  ],
  "scripts": {
    "generate": "node scripts/generate-manifest.mjs",
    "predev": "npm run generate",
    "dev": "node esbuild.config.mjs",
    "prebuild": "npm run generate",
    "build": "node esbuild.config.mjs production",
    "postbuild": "node scripts/check-bundle-size.mjs",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,mjs,json}\"",
    "pretest": "npm run generate",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "handlebars": "^4.7.9",
    "js-yaml": "^5.4.1",
    "marked": "^18.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/browser-playwright": "^4.1.11",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.10.0",
    "obsidian": "latest",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.5"
  }
}
