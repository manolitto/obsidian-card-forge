{{!--
  Simple — card back.
  A white field: the game's name set large and centred, with the card's kind
  as a quiet, letter-spaced subtitle beneath a short hairline. The subtitle
  and its separator stay out when no kind is given.
--}}
<div class="card-root card-back simple simple-back">
  <div class="simple-back-frame">
    <div class="simple-back-game"><span class="text-scalable">{{slot "back-title"}}</span></div>
    {{#if (slot "back-subtitle")}}
    <div class="simple-back-sep"></div>
    <div class="simple-back-type"><span class="text-scalable">{{slot "back-subtitle"}}</span></div>
    {{/if}}
  </div>
</div>
