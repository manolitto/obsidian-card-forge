{{!--
  Swords & Wizardry — the back of both card types: a flourish pair above
  and below, the wordmark with the ampersand on its own line, the card
  type's label in small capitals, the tagline. Typography only.
--}}
<div class="card-root card-back sw {{card-type}}-card {{card-type}}-back">
  <div class="sw-back">
    <div class="sw-back-flourish"></div>
    <div class="sw-back-wordmark">
      {{t "back-wordmark-line-1"}}
      <span class="sw-back-ampersand">{{t "back-wordmark-ampersand"}}</span>
      {{t "back-wordmark-line-2"}}
    </div>
    <div class="sw-back-label"><span class="text-scalable">{{t "back-label"}}</span></div>
    <div class="sw-back-tagline">{{t "back-tagline"}}</div>
    <div class="sw-back-flourish sw-back-flourish-bottom"></div>
  </div>
</div>
