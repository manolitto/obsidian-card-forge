{{!--
  MINI D20 — the archetype front.

    front-stat-1 … 3   TP, RK, RW at level 1, in three columns
    front-skills       the skill bonuses — a list of single-key pairs, set
                       in two columns: the grid fills left to right, so the
                       odd entries land left and the even ones right
    front-armor,
    front-weapons      the allowed gear, each a list joined with commas
    front-abilities    the starting-abilities rule, one line per entry
    front-level-up     the level-up rule, one line per entry
--}}
<div class="card-root card-front mini-d20 archetype-card">
  {{> header}}

  <div class="card-content-container">
    <div class="card-body-scalable">

    {{#if (or (slot "front-stat-1") (slot "front-stat-2") (slot "front-stat-3"))}}
    <span class="cs-fill-1 cs-keep-with-next"></span>
    <div class="mini-d20-stats mini-d20-archetype-stats">
      <div class="mini-d20-stat-h">{{slot-label "front-stat-1"}}</div>
      <div class="mini-d20-stat-h">{{slot-label "front-stat-2"}}</div>
      <div class="mini-d20-stat-h">{{slot-label "front-stat-3"}}</div>
      <div class="mini-d20-stat-v">{{slot "front-stat-1" markdown=false}}</div>
      <div class="mini-d20-stat-v">{{slot "front-stat-2" markdown=false}}</div>
      <div class="mini-d20-stat-v">{{slot "front-stat-3" markdown=false}}</div>
    </div>
    {{/if}}

    {{#if (slot "front-skills" list=true)}}
    <span class="cs-fill-1 cs-keep-with-next"></span>
    <div class="mini-d20-subheader cs-keep-with-next">{{slot-label "front-skills"}}</div>
    <div class="mini-d20-archetype-skills">
      {{#each (slot "front-skills" list=true)}}{{#each this}}<div class="mini-d20-archetype-skill-name">{{@key}}</div><div class="mini-d20-archetype-skill-bonus">{{this}}</div>{{/each}}{{/each}}
    </div>
    {{/if}}

    {{#if (or (slot "front-armor") (slot "front-weapons"))}}
    <span class="cs-fill-1 cs-keep-with-next"></span>
    <div class="mini-d20-rows mini-d20-archetype-allowed">
      {{#if (slot "front-armor")}}
      <div class="mini-d20-row-label">{{slot-label "front-armor"}}</div>
      <div class="mini-d20-row-value">{{slot "front-armor" plain=true}}</div>
      {{/if}}
      {{#if (slot "front-weapons")}}
      <div class="mini-d20-row-label">{{slot-label "front-weapons"}}</div>
      <div class="mini-d20-row-value">{{slot "front-weapons" plain=true}}</div>
      {{/if}}
    </div>
    {{/if}}

    {{#if (slot "front-abilities" list=true)}}
    <span class="cs-fill-1 cs-keep-with-next"></span>
    <div class="mini-d20-subheader cs-keep-with-next">{{slot-label "front-abilities"}}</div>
    <div class="mini-d20-prose">
      {{#each (slot "front-abilities" list=true)}}<p>{{this}}</p>{{/each}}
    </div>
    {{/if}}

    {{#if (slot "front-level-up" list=true)}}
    <span class="cs-fill-1 cs-keep-with-next"></span>
    <div class="mini-d20-subheader cs-keep-with-next">{{slot-label "front-level-up"}}</div>
    <div class="mini-d20-prose">
      {{#each (slot "front-level-up" list=true)}}<p>{{this}}</p>{{/each}}
    </div>
    {{/if}}

    {{> flavour}}

    <span class="cs-fill-2"></span>

    </div>
  </div>

  {{> footer}}
</div>
