{{!--
  Simple — card front.
  Minimalist: a title, a thin rule, the Markdown body, and a muted source
  line in the footer. header → body → footer flex convention: the footer is a
  flex sibling of `.card-content-container`, so it reappears on every overflow
  continuation card. The overflow counter sits quietly beside the title and is
  hidden (`:empty`) on single cards.
--}}
<div class="card-root card-front simple simple-card">

  <div class="card-header simple-header">
    <div class="card-title simple-title">{{scale-text props.name}}<span class="cf-overflow-counter"></span></div>
    <div class="simple-rule"></div>
  </div>

  <div class="card-content-container simple-content">
    {{#scale-body}}
    <div class="simple-body">{{nl2br props.content}}</div>
    {{/scale-body}}
  </div>

  {{#if props.reference}}
  <div class="card-footer simple-footer">{{wikilink-text props.reference}}</div>
  {{/if}}

</div>
