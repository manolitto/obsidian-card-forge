{{!--
  MINI D20 — the cover back: licences and acknowledgements under a
  heading. The text is the note's own, before its first `##` heading;
  its `###` headings become the small caps sub-heads.

    back-text   the note's body
--}}
<div class="card-root card-back mini-d20 cover-card cover-back">
  <div class="card-header">
    <div class="mini-d20-title-strip"><span class="text-scalable mini-d20-title">{{t "back-heading"}}</span></div>
  </div>

  <div class="card-content-container">
    <div class="card-body-scalable">
    <div class="mini-d20-cover-licence">{{slot "back-text" markdown="block"}}</div>
    </div>
  </div>
</div>
