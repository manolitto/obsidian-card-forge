{{!--
  Dungeon Crawl Classics — the back of both card types: the card type's
  label over a thin rule, the crimson wordmark, the tagline. Typography
  only, no picture.
--}}
<div class="card-root card-back dcc {{card-type}}-card {{card-type}}-back">
  <div class="dcc-back">
    <div class="dcc-back-banner"><span class="text-scalable">{{t "back-label"}}</span></div>
    <div class="dcc-back-mark">
      <div class="dcc-wordmark">{{> wordmark}}</div>
      <div class="dcc-tagline"><span class="text-scalable">{{t "back-tagline"}}</span></div>
    </div>
  </div>
</div>
